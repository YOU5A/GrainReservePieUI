    "texture": "textures/ui/Black",
    "controls": [
      { "＆1@RGB_Finally": { "ignored": true, "anchor_from": "bottom_left", "anchor_to": "bottom_left", "layer": 1 } },
      { "＆2@hotbar_left_image": { "offset": ["0.5%",0], "anchor_from": "left_middle", "anchor_to": "left_middle", "layer": 1 } },
      { "＆3@hotbar_left_text": { "offset": ["2.5%",0.5], "anchor_from": "left_middle", "anchor_to": "left_middle", "layer": 1 } },
      { "＆4@hotbar_right_text": { "offset": ["default",0.5], "anchor_from": "right_middle", "anchor_to": "right_middle", "layer": 1 } }
    ],
