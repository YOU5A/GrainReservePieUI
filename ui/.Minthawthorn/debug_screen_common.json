  "Hanabi_hotbar_panel": {
    "type": "image",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": "$hotbar_size",
    "offset": "@debug_screen.hotbar_animation",
    "$hotbar_size|default": [ "100%", 25 ],
