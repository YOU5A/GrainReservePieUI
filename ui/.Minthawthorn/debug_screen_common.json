{
  "namespace":"debug_screen",

  // Dev Pack Info

  "dev_pack_info": {
    "ignored": "(not $rainbowpie_ui_debug)",
    "type": "image",
    "size": [ "100%c + 2px", "10px" ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "texture": "textures/ui/Black",
    "layer": 999,
    "alpha": 0.4,
    "controls": [
      {
        "text_label": {
          "type": "label",
          "color": "$main_header_text_color",
          "text": "test.version.text",
          "layer": 101,
          "alpha": 0.85464,
          "font_type": "$rainbowpie_ui_theme_global_font_name",
          "backup_font_type": "$rainbowpie_ui_theme_global_font_backup_name",
          "size": [ "default", 10 ]
        }
      }
    ]
  },

  // Screen 屏幕

  "anim_grpw_bg_lite": {
    "anim_type": "alpha",
    "duration": 0.1,
    "from": 0.4,
    "to": 0.4,
    "next": "@debug_screen.anim_grpw_bg"
  },
  "anim_grpw_bg": {
    "anim_type": "wait",
    "duration": 3.0,
    "next": "@debug_screen.anim_grpw_bg_end"
  },
  "anim_grpw_bg_end": {
    "anim_type": "alpha",
    "easing": "in_expo",
    "duration": 3.0,
    "from": 0.4,
    "to": 0
  },
  "anim_grpw_text_lite": {
    "anim_type": "alpha",
    "duration": 0.1,
    "from": 1.0,
    "to": 1.0,
    "next": "@debug_screen.anim_grpw_text"
  },
  "anim_grpw_text": {
    "anim_type": "wait",
    "duration": 3.0,
    "next": "@debug_screen.anim_grpw_text_end"
  },
  "anim_grpw_text_end": {
    "anim_type": "alpha",
    "easing": "in_expo",
    "duration": 3.0,
    "from": 1.0,
    "to": 0
  },

  "start_Welcome_text": {
    "type": "image",
    "layer": -1,
    "size": [ "100%c + 6px", "100%c + 2px" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, "10%" ],
    "texture": "textures/ui/Black",
    "alpha": "@debug_screen.anim_grpw_bg_lite",
    "controls": [
      {
        "text_label": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "text_alignment": "center",
          "layer": 1,
          "color": "$tool_tip_text",
          "text": "Welcome",
          "font_type": "$rainbowpie_ui_theme_global_font_name",
          "shadow": true,
          "alpha": "@debug_screen.anim_grpw_text_lite"
        }
      }
    ]
  },

  "mod_Welcome_text": {
    "type": "image",
    "layer": -1,
    "size": [ "100%c + 6px", "100%c + 2px" ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ -7, -15 ],
    "texture": "textures/ui/Black",
    "alpha": "@debug_screen.anim_grpw_bg_lite",
    "controls": [
      {
        "text_label": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "text_alignment": "center",
          "layer": 1,
          "color": "$tool_tip_text",
          "text": "welcome.mod.text",
          "font_type": "$rainbowpie_ui_theme_global_font_name",
          "shadow": true,
          "alpha": "@debug_screen.anim_grpw_text_lite"
        }
      }
    ]
  },

  "grain_reserve_text": {
    "type": "image",
    "size": [ "100%c + 6px", "100%c + 2px" ],
    "offset": [ "default", 0.5 ],
    "texture": "textures/ui/Black",
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "alpha": 0.5,
    "layer": 100,
    "controls": [
      {
        "text_label": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "text": "('@ - ' + $mintui_pack_name)",
          "enable_profanity_filter": false,
          "layer": 1,
          "shadow": true,
          "font_size": "medium",
          "font_type": "$rainbowpie_ui_theme_global_font_name",
          "backup_font_type": "$rainbowpie_ui_theme_global_font_backup_name",
          "controls": [
            {
              "input_panel": {
                "type": "input_panel",
                "prevent_touch_input": true,
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "size": [ "100%", "100%" ],
                "offset": [ -2, -1 ],
                "controls": [
                  {
                    "image": {
                      "type": "image",
                      "size": [ "100%", "100%" ],
                      "texture": "textures/ui/White",
                      "color": "$c_color_format",
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "alpha": 0,
                      "controls": [
                        {
                          "button@debug_screen.hud_setting_toggle":{ "size": [ "100%", "100%" ],"layer": 999 }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "logo_screen": {
    "type": "panel",
    "controls": [
      {
        "text": {
          "type": "label",
          "alpha": 0.1,
          "offset": [0, -20],
          "text": "$mintui_pack_name",
          "layer": 100,
          "shadow": true,
          "font_type": "$rainbowpie_ui_theme_global_font_name",
          "font_scale_factor": 6.0
        }
      },
      {
        "text_2": {
          "type": "label",
          "alpha": 0.2,
          "offset": [0, 20],
          "text": "('By - ' + $mintui_clientAuthor)",
          "layer": 100,
          "shadow": true,
          "font_type": "$rainbowpie_ui_theme_global_font_name",
          "font_scale_factor": 1.0
        }
      }
    ],
   "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "debug_screen.False_Toolbox",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "compass_clock": {
    "type": "panel",
    "controls": [
      { "&1@debug_screen.compass_clock_control": { }}
    ]
  },

  "compass_clock_control": {
    "type": "image",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ -140, 0 ],
    "size": [ 35, 20 ],
    "alpha": 0.2,
    "texture": "textures/PFMAXLNX/r_black",
    "controls": [
      {
        "compass_and_clock_panel": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "anchor_to": "center",
          "anchor_from": "center",
          "size": [ "100%c", 16 ],
          "offset": [ 0, 0 ],
          "controls": [
            {
              "clock@common.item_renderer": {
                "size": [ 16, 16 ],
                "property_bag": {
                  "#item_id_aux": "(398 * 65536)"//"26083328"
                },
                "bindings": []
              }
            },
            {
              "compass@common.item_renderer": {
                "size": [ 16, 16 ],
                "property_bag": {
                  "#item_id_aux": "(396 * 65536)"//"25952256"
                },
                "bindings": []
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "debug_screen.compass_and_clock_control",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

 "keystrokes_label":{
  "font_type":"$rainbowpie_ui_theme_global_font_name",
  "anchor_from":"bottom_right",
  "anchor_to":"bottom_right",

  "shadow":"$key_shadow",
  "color":"$key_color",
  "alpha":"$key_alpha",

  "offset":"$label_offset",
  "type":"label",
  "text":"$text",
  "layer": 2
 },

 "space_label":{
  "type": "image",
  "size": [ 22, 1 ],
  "anchor_from":"bottom_right",
  "anchor_to":"bottom_right",
  "texture": "textures/ui/White",
  "offset":[-20,-5]
 },
