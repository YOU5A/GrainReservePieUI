  "$text":"LMB",
  "$label_offset":[-38,-14],
  "font_scale_factor":1
 },
 "rmb_label@debug_screen.keystrokes_label":{
  "$text":"RMB",
  "$label_offset":[-6.5,-14],
  "font_scale_factor":1
 },
 "w_label@debug_screen.keystrokes_label":{
  "$text":"W",
  "$label_offset":[-27.5,-52.5],
  "font_scale_factor":1.1
 },
 "a_label@debug_screen.keystrokes_label":{
  "$text":"A",
  "$label_offset":[-49.5,-32],
  "font_scale_factor":1.1
 },
 "s_label@debug_screen.keystrokes_label":{
  "$text":"S",
  "$label_offset":[-30,-32],
  "font_scale_factor":1.1
 },
 "d_label@debug_screen.keystrokes_label":{
  "$text":"D",
  "$label_offset":[-8,-32],
  "font_scale_factor":1.1
 },

  "keystrokes_panel": {
    "type": "panel",
    "controls": [
      {"keystrokes_direction@debug_screen.keystrokes_direction":{}},
      {"space_label@debug_screen.space_label":{}},
      {"lmb_label@debug_screen.lmb_label":{}},
      {"rmb_label@debug_screen.rmb_label":{}},
      {"w_label@debug_screen.w_label":{}},
      {"a_label@debug_screen.a_label":{}},
      {"s_label@debug_screen.s_label":{}},
      {"d_label@debug_screen.d_label":{}}
    ]
  },

  "keystrokes_contents": {
    "type": "panel",
    "offset": "$keystroke_offset",
    "controls": [
      { "keystrokes_panel@debug_screen.keystrokes_panel": {} }
    ],
    "variables": [
      {
        "requires": "$mouse",
        "$keystroke_offset": ["-0.5%","-3.8%"]
      },
      {
        "requires": "$touch",
        "$keystroke_offset": ["-0.5%","-4.5%"]
      },
      {
        "requires": "$win10_edition",
        "$keystroke_offset": ["-0.5%","-4.2%"]
      },
      {
        "requires": "$is_ios",
        "$keystroke_offset": ["-0.5%","-4.5%"]
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "debug_screen.keystrokes_ds_control",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "keystrokes_content": {
    "type": "panel",
    "ignored": "$keystrokes",
    "controls": [
      { "keystrokes_panel@debug_screen.keystrokes_contents": {} }
    ],
    "bindings": [
      {
        "binding_name": "#hud_visible",
        "binding_name_override": "#visible",
        "binding_type": "global"
      }
    ]
  },

