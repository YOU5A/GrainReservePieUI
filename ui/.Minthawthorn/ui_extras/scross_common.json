  "cross_image": {
    "type": "image",
    "$texture|default": "textures/PFMAXLNX/tm",
    "$color|default": [ 1,1,1 ],
    "$anims|default": "",
    "size": [ 12,12 ],
    "layer": 1,
    "alpha": 0.8,
    "controls": [
      {
        "cross_image": {
          "type": "image",
          "texture": "$texture",
          "color": "$color",
          "anims": "$anims",
          "bindings":[
            {
              "binding_type": "view",
              "source_control_name": "debug_screen.scross_rgb_control",
              "source_property_name": "(not #toggle_state)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "rgb_image": {
          "type": "image",
          "texture": "$texture",
          "color": "$color",
          "anims": [ "@color.rgb_color_01" ],
          "bindings":[
            {
              "binding_type": "view",
              "source_control_name": "debug_screen.scross_rgb_control",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

