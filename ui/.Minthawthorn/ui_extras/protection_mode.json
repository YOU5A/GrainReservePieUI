{
  "namespace":"hud",

  "al_content": {
    "ignored": "($mintui_pack_name = 'G' + 'r' + 'a' + 'i' + 'n' + ' ' + 'R' + 'e' + 's' + 'e' + 'r' + 'v' + 'e' + ' ' + 'P' + 'i' + 'e')",
    "type": "panel",
    "layer": 99999,
    "controls": [
      {
        "common_panel@common.common_panel": {
          "$show_close_button": false,
          "size": [ "100% - 150px", "100% - 60px"],
          "$dialog_background": "dialog_background_hollow_3"
        }
      },
      {
        "container": {
          "type": "panel",
          "size": [ "100% - 150px", "100% - 60px"],
          "controls": [
            { "dialog_content@hud.dialog_content": { } }
          ]
        }
      }
    ]
  },

  "dialog_content": {
    "type": "panel",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      { "dialog_title_label@hud.dialog_title_label": { "offset": [ 0, 9 ] } },
      { "content_area@hud.content_area": { } }
    ]
  },

  "dialog_title_label": {
    "type": "label",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "layer": 2,
    "color": [ 0.275, 0.275, 0.275 ],
    "text": "\u5ba2\u6237\u7aef\u53d8\u91cf\u9519\u8bef"
  },

  "content_area@common.modal_area_panel_base": {
    "offset": [ "0px", "23px" ],
    "size": [ "100% - 15px", "100% - 31px" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "layer": 1,
    "$modal_binding_name": "#content_area_focused",
    "controls": [
      {
        "content": {
          "type": "stack_panel",
          "size": [ "100%", "100%" ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            {
              "scrolling_panel@common.scrolling_panel": {
                "size": [ "100%", "fill" ],
                "$scrolling_content": "hud.content_panel",
                "$show_background": false,
                "$scroll_size": [ "5px", "100% - 4px" ],
                "$scroll_bar_left_padding_size": [ 0, 0 ]
              }
            }
          ]
        }
      }
    ]
  },

  "content_panel": {
    "type": "stack_panel",
    "size": [ "100%-10px", "100%c" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 5, 0 ],
    "controls": [
      {
        "label_panel_1": {
          "type": "panel",
          "size": [ "100%", 18 ],
          "controls": [
            {
              "label": {
