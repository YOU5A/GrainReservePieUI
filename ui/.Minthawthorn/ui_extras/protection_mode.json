                "text": "\u6211\u4eec\u68c0\u67e5\u5230\u8be5\u7248\u672c\u5df2\u7ecf\u88ab\u4fee\u6539\uff0c\u8bf7\u9605\u8bfb\u5305\u5185copyright.txt\u6587\u4ef6\u6765\u51b3\u5b9a\u662f\u5426\u5c06\u8be5\u7248\u672c\u53d1\u5e03\u3002\uff08\u672c\u63d0\u793a\u6bcf\u6b21\u542f\u52a8\u90fd\u4f1a\u663e\u793a\uff09",
                "size": [ "100%", 8 ],
