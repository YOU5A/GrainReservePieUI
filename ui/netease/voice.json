{
  "namespace": "voice",

  "voice_dialog_screen@common.base_screen": {
    "type": "screen",
    "force_render_below": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_up",
        "to_button_id": "button.menu_up",
        "mapping_type": "global",
        "scope": "view"
      },
      {
        "from_button_id": "button.menu_down",
        "to_button_id": "button.menu_down",
        "mapping_type": "global",
        "scope": "view"
      },
      {
        "from_button_id": "button.menu_left",
        "to_button_id": "button.menu_left",
        "mapping_type": "global",
        "scope": "view"
      },
      {
        "from_button_id": "button.menu_right",
        "to_button_id": "button.menu_right",
        "mapping_type": "global",
        "scope": "view"
      },
      {
        "from_button_id": "button.menu_tab_left",
        "to_button_id": "button.menu_tab_left",
        "mapping_type": "global",
        "scope": "view"
      },
      {
        "from_button_id": "button.menu_tab_right",
        "to_button_id": "button.menu_tab_right",
        "mapping_type": "global",
        "scope": "view"
      }
    ],
    "$screen_content": "voice.settings_content"
  },

  "settings_content": {
    "type": "panel",
    "controls": [
      {
        "header@common_store.store_top_bar": {
          "offset": "@permissions.top_bar_animation",
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "layer": 3,
          "controls": [
            {
              "title_panel": {
                "type": "panel",
                "size": [ "100%", 19 ],
                "controls": [
                  {
                    "title_label": {
                      "type": "label",
                      "text": "#dialog_title",
                      "font_type": "$rainbowpie_ui_theme_global_font_name",
                      "size": [ "100%", 10 ],
                      "offset": [ 20, -1 ],
                      
                      "color": [ 0.3, 0.3, 0.3 ],
                      "layer": 2,
                      "bindings": [
                        {
                          "binding_name": "#dialog_title"
                        }
                      ]
                    }
                  },
                  {
                    "back_button_content_panel@chat.back_content_panel": {
                      "offset": [ 2, 0 ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "background": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": [ "500%", "500%" ],
          "alpha": 0.5,
          "layer": -1
        }
      },
      {
        "container": {
          "type": "panel",
          "size": [ "100%", "100%"],
          "controls": [
            { "dialog_content@voice.dialog_content": { } }
          ]
        }
      }
    ]
  },

  "dialog_content": {
    "type": "panel",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      { "content_area@voice.content_area": { } }
    ]
  },

  "content_area@common.modal_area_panel_base": {
    "offset": [ "0px", "19px" ],
    "size": [ "100%", "100%" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "layer": 1,
    "$modal_binding_name": "#content_area_focused",
    "controls": [
      {
        "content": {
          "type": "stack_panel",
          "size": [ "100%", "100%" ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            {
              "scrolling_panel@common.scrolling_panel": {
                "size": [ "100%", "fill" ],
                "$scrolling_content": "voice.content_panel",
                "$show_background": false,
                "$scroll_size": [ "5px", "100% - 4px" ],
                "$scroll_bar_left_padding_size": [ 0, 0 ]
              }
            }
          ]
        }
      }
    ]
  }
}